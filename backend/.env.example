PORT=5000
NODE_ENV=production
# MongoDB connection string (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blogspace?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blogspace?retryWrites=true&w=majority
JWT_SECRET=supersecret_jwt_random_hash_key_min_32_chars
JWT_EXPIRES_IN=30d
CLIENT_URL=https://your-blogspace-frontend.vercel.app

# Optional Cloudinary storage (local disk storage fallback is used if left blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
